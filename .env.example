# Docker deployment configuration. Copy to .env; keep secrets untracked.
SITE_DOMAIN=quiz.example.com
# Generate: php apps/api/artisan key:generate --show
APP_KEY=
# Generate a strong unique database password.
DB_PASSWORD=
# Production SMTP credentials (use --profile local-mail only for local testing).
MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
